# Copy to .env (never commit .env). In production these live in the host's secret manager.

# "csv" runs against data/sample_readings.csv; "google" reads the real sheet.
INPUT_SOURCE=csv
CSV_PATH=data/sample_readings.csv

# Google (INPUT_SOURCE=google). Input credentials must be a read-only service account
# that has been shared on the input sheet as Viewer. Output uses a separate account.
INPUT_SPREADSHEET_ID=
INPUT_WORKSHEET=Readings
INPUT_CREDENTIALS_PATH=credentials/input-readonly.json
OUTPUT_SPREADSHEET_ID=
OUTPUT_CREDENTIALS_PATH=credentials/output-writer.json

# Weather (Open-Meteo, no key). Defaults to Goma.
SITE_LATITUDE=-1.6585
SITE_LONGITUDE=29.2205

# AI summary
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-haiku-5-5
SUMMARY_MAX_ATTEMPTS=3

# Email (SMTP). Leave SMTP_HOST empty to print the report instead of sending it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Where pending/approved reports are stored
STATE_DIR=state
